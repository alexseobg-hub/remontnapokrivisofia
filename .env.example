# Notion integration token (Internal integration, https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_xxx

# Databases under the parent page "Ремонт на покриви София — CMS"
NOTION_PAGES_DB=d02a436835f541ab8347b277d15e2287
NOTION_SETTINGS_DB=a8533dbee9e042c4a46cc0ffb40f839f
NOTION_PRICING_DB=bbe8e8ee98654cb9a1cb9863524f4cbc
NOTION_PROJECTS_DB=c061b5cd09f544d7bf315b3d44e8ce48
NOTION_TESTIMONIALS_DB=0a5ef4b768e44b01aef45eedc85f9260

# Public site address, used for canonical, og:url, sitemap and JSON-LD
VITE_SITE_URL=https://remontnapokrivisofia.bg

# Where the lead form posts. /api/lead is the built-in receiver (api/lead.js),
# which writes the enquiry into the Notion database below. Empty = the form
# tells the visitor it is not connected instead of pretending it sent.
VITE_FORM_ENDPOINT=/api/lead

# Database the receiver writes to. Needed by api/lead.js, not by the build.
NOTION_LEADS_DB=4934100220ae476d85e467f8ae4914e1

# Optional email on every enquiry. Without these the Notion row is the only copy.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
